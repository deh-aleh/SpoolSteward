#: spoolsteward/admin/templates/_own_notices.html:8
#, python-format
msgid "An administrator revoked your print key “%(label)s” (starts with %(prefix)s). It no longer works: create another one in <a href=\"/me/keys\">Devices</a> if you need it."
msgstr "Un amministratore ha revocato la tua chiave di stampa «%(label)s» (inizia con %(prefix)s). Non funziona più: se ti serve, creane un'altra in <a href=\"/me/keys\">Dispositivi</a>."

#: spoolsteward/admin/templates/_own_notices.html:10
#, python-format
msgid "An administrator revoked all your print keys (%(n)s). They no longer work: create new ones in <a href=\"/me/keys\">Devices</a> if you need them."
msgstr "Un amministratore ha revocato tutte le tue chiavi di stampa (%(n)s). Non funzionano più: se ti servono, creane di nuove in <a href=\"/me/keys\">Dispositivi</a>."

#: spoolsteward/admin/templates/_own_notices.html:12
#, python-format
msgid "An administrator switched off your print key “%(label)s” (starts with %(prefix)s). It does not work for now, and its expiry date does not change."
msgstr "Un amministratore ha disattivato la tua chiave di stampa «%(label)s» (inizia con %(prefix)s). Per ora non funziona e la data di scadenza non cambia."

#: spoolsteward/admin/templates/_own_notices.html:14
#, python-format
msgid "An administrator switched your print key “%(label)s” (starts with %(prefix)s) back on. It works again."
msgstr "Un amministratore ha riattivato la tua chiave di stampa «%(label)s» (inizia con %(prefix)s). Funziona di nuovo."

#: spoolsteward/admin/templates/_own_notices.html:16
#, python-format
msgid "An administrator extended your print key “%(label)s” (starts with %(prefix)s). It now expires on %(date)s."
msgstr "Un amministratore ha prolungato la tua chiave di stampa «%(label)s» (inizia con %(prefix)s). Ora scade il %(date)s."

#: spoolsteward/admin/templates/_own_notices.html:18
#, python-format
msgid "Your print key “%(label)s” (starts with %(prefix)s) expires on %(date)s. Create a new one before then and set it up on your devices."
msgstr "La tua chiave di stampa «%(label)s» (inizia con %(prefix)s) scade il %(date)s. Creane una nuova prima di quella data e configurala sui tuoi dispositivi."

#: spoolsteward/admin/templates/_own_notices.html:20
#, python-format
msgid "An administrator moved you from the group “%(old)s” to the group “%(new)s”. Your limits are now those of the new group."
msgstr "Un amministratore ti ha spostato dal gruppo “%(old)s” al gruppo “%(new)s”. I tuoi limiti sono ora quelli del nuovo gruppo."

#: spoolsteward/admin/templates/_own_notices.html:22
msgid "An administrator made you an administrator. You can now manage users, groups and printers: the menu has the new pages."
msgstr "Un amministratore ti ha reso amministratore. Ora puoi gestire utenti, gruppi e stampanti: il menu ha le nuove pagine."

#: spoolsteward/admin/templates/_own_notices.html:24
#, python-format
msgid "An administrator removed your administrator rights. You are now in the group “%(group)s”."
msgstr "Un amministratore ti ha tolto i diritti di amministratore. Ora sei nel gruppo “%(group)s”."

#: spoolsteward/admin/templates/_own_notices.html:26
#, python-format
msgid "An administrator gave you a permission: %(what)s, %(when)s."
msgstr "Un amministratore ti ha dato un permesso: %(what)s, %(when)s."

#: spoolsteward/admin/templates/_own_notices.html:26
#: spoolsteward/admin/templates/_own_notices.html:37
#, python-format
msgid "until the end of %(date)s"
msgstr "fino alla fine del %(date)s"

#: spoolsteward/admin/templates/_own_notices.html:26
#: spoolsteward/admin/templates/_own_notices.html:37
msgid "with no end date"
msgstr "senza scadenza"

#: spoolsteward/admin/templates/_own_notices.html:26
#: spoolsteward/admin/templates/_own_notices.html:32
#: spoolsteward/admin/templates/_own_notices.html:38
#: spoolsteward/admin/templates/_own_notices.html:40
#, python-format
msgid "Note: %(note)s"
msgstr "Nota: %(note)s"

#: spoolsteward/admin/templates/_own_notices.html:28
#, python-format
msgid "An administrator withdrew the permission you had been given: %(what)s."
msgstr "Un amministratore ha ritirato il permesso che ti era stato dato: %(what)s."

#: spoolsteward/admin/templates/_own_notices.html:30
#, python-format
msgid "The permission you had been given has ended: %(what)s. You can ask for it again from <a href=\"/me\">Account</a>."
msgstr "Il permesso che ti era stato dato è terminato: %(what)s. Puoi chiederlo di nuovo da <a href=\"/me\">Account</a>."

#: spoolsteward/admin/templates/_own_notices.html:32
#, python-format
msgid "An administrator gave you extra quota: %(amount)s %(metric)s, %(scope)s."
msgstr "Un amministratore ti ha dato una quota extra: %(amount)s %(metric)s, %(scope)s."

#: spoolsteward/admin/templates/_own_notices.html:34
#, python-format
msgid "An administrator withdrew your extra quota of %(amount)s %(metric)s."
msgstr "Un amministratore ha ritirato la tua quota extra di %(amount)s %(metric)s."

#: spoolsteward/admin/templates/_own_notices.html:36
#, python-format
msgid "Your request to change group was approved: you are now in the group “%(group)s”."
msgstr "La tua richiesta di cambio gruppo è stata approvata: ora sei nel gruppo “%(group)s”."

#: spoolsteward/admin/templates/_own_notices.html:37
#, python-format
msgid "Your request for a permission was approved: %(what)s, %(when)s."
msgstr "La tua richiesta di un permesso è stata approvata: %(what)s, %(when)s."

#: spoolsteward/admin/templates/_own_notices.html:38
#, python-format
msgid "Your request for more quota was approved: %(amount)s %(metric)s, %(scope)s."
msgstr "La tua richiesta di più quota è stata approvata: %(amount)s %(metric)s, %(scope)s."

#: spoolsteward/admin/templates/_own_notices.html:40
#, python-format
msgid "Your request for a permission was rejected: %(what)s."
msgstr "La tua richiesta di un permesso è stata rifiutata: %(what)s."

#: spoolsteward/admin/templates/_own_notices.html:40
msgid "Your request was rejected."
msgstr "La tua richiesta è stata rifiutata."

#: spoolsteward/admin/templates/_own_notices.html:43
#, python-format
msgid "The printer “%(printer)s” has a paper jam, and your print is waiting. Somebody has to clear it; the print will go on by itself."
msgstr "La stampante “%(printer)s” ha un inceppamento della carta e la tua stampa è in attesa. Qualcuno deve liberarla; la stampa riprenderà da sola."

#: spoolsteward/admin/templates/_own_notices.html:44
#, python-format
msgid "The printer “%(printer)s” is out of paper (or the tray is empty), and your print is waiting. When paper is loaded the print will go on by itself."
msgstr "La stampante “%(printer)s” è senza carta (o il vassoio è vuoto) e la tua stampa è in attesa. Quando viene caricata la carta la stampa riprenderà da sola."

#: spoolsteward/admin/templates/_own_notices.html:45
#, python-format
msgid "The printer “%(printer)s” is out of ink or toner, and your print may not come out right or may stop. Tell whoever looks after the printer."
msgstr "La stampante “%(printer)s” ha finito inchiostro o toner e la tua stampa potrebbe uscire male o fermarsi. Avvisa chi si occupa della stampante."

#: spoolsteward/admin/templates/_own_notices.html:46
#, python-format
msgid "The printer “%(printer)s” reports a problem, and your print is waiting."
msgstr "La stampante “%(printer)s” segnala un problema e la tua stampa è in attesa."

#: spoolsteward/admin/templates/_own_notices.html:48
msgid "An administrator changed what you may print (colour, one-sided prints, printers or hours). <a href=\"/me\">Account</a> shows your permissions."
msgstr "Un amministratore ha cambiato cosa puoi stampare (colore, stampe solo fronte, stampanti o orari). <a href=\"/me\">Account</a> mostra i tuoi permessi."

#: spoolsteward/admin/templates/_own_notices.html:51
#, python-format
msgid "Your print to “%(printer)s” was refused: your account is not allowed to use that printer. <a href=\"/me\">Account</a> shows the printers you can use."
msgstr "La tua stampa su «%(printer)s» è stata rifiutata: il tuo account non può usare quella stampante. <a href=\"/me\">Account</a> mostra le stampanti che puoi usare."

#: spoolsteward/admin/templates/_own_notices.html:52
#, python-format
msgid "Your print to “%(printer)s” was refused: printing is allowed only %(window)s."
msgstr "La tua stampa su “%(printer)s” è stata rifiutata: si può stampare solo %(window)s."

#: spoolsteward/admin/templates/_own_notices.html:52
#, python-format
msgid "Your print to “%(printer)s” was refused: printing is not allowed at this hour."
msgstr "La tua stampa su “%(printer)s” è stata rifiutata: a quest'ora non è consentito stampare."

#: spoolsteward/admin/templates/_own_notices.html:53
#, python-format
msgid "Your print to “%(printer)s” was refused: colour printing is not allowed for your account. Choose black and white in the print window and send it again."
msgstr "La tua stampa su “%(printer)s” è stata rifiutata: la stampa a colori non è consentita al tuo account. Scegli bianco e nero nella finestra di stampa e invia di nuovo."

#: spoolsteward/admin/templates/_own_notices.html:54
#, python-format
msgid "Your print to “%(printer)s” was refused: one-sided printing is not allowed for your account. Choose double-sided in the print window and send it again."
msgstr "La tua stampa su “%(printer)s” è stata rifiutata: la stampa solo fronte non è consentita al tuo account. Scegli fronte-retro nella finestra di stampa e invia di nuovo."

#: spoolsteward/admin/templates/_own_notices.html:55
#, python-format
msgid "Your print to “%(printer)s” was refused."
msgstr "La tua stampa su “%(printer)s” è stata rifiutata."

#: spoolsteward/admin/templates/_own_notices.html:58
#, python-format
msgid "Your print to “%(printer)s” was refused: the %(period)s %(noun)s limit is reached (%(used)s/%(limit)s). <a href=\"/me/request/quota\">Ask for more quota</a>."
msgstr "La tua stampa su «%(printer)s» è stata rifiutata: il limite %(period)s di %(noun)s è raggiunto (%(used)s/%(limit)s). <a href=\"/me/request/quota\">Chiedi più quota</a>."

#: spoolsteward/admin/templates/_own_notices.html:61
#, python-format
msgid "Your print to “%(printer)s” was made in black and white: colour printing is not allowed for your account."
msgstr "La tua stampa su “%(printer)s” è stata fatta in bianco e nero: la stampa a colori non è consentita al tuo account."

#: spoolsteward/admin/templates/_own_notices.html:61
#, python-format
msgid "Your print to “%(printer)s” was made double-sided: one-sided printing is not allowed for your account."
msgstr "La tua stampa su “%(printer)s” è stata fatta in fronte-retro: la stampa solo fronte non è consentita al tuo account."

#: spoolsteward/admin/templates/_own_notices.html:63
#, python-format
msgid "Scan refused: the window was for %(expected)s, the request comes from %(got)s. Open the portal from the device that scans, or see the scanning help in the user guide."
