#, python-format
msgid "An administrator switched off your print key “%(label)s” (starts with %(prefix)s). It does not work for now, and its expiry date does not change."
msgstr "Un administrador ha desactivado tu clave de impresión «%(label)s» (empieza por %(prefix)s). Por ahora no funciona y su fecha de caducidad no cambia."

#: spoolsteward/admin/templates/_own_notices.html:14
#, python-format
msgid "An administrator switched your print key “%(label)s” (starts with %(prefix)s) back on. It works again."
msgstr "Un administrador ha vuelto a activar tu clave de impresión «%(label)s» (empieza por %(prefix)s). Vuelve a funcionar."

#: spoolsteward/admin/templates/_own_notices.html:16
#, python-format
msgid "An administrator extended your print key “%(label)s” (starts with %(prefix)s). It now expires on %(date)s."
msgstr "Un administrador ha ampliado tu clave de impresión «%(label)s» (empieza por %(prefix)s). Ahora caduca el %(date)s."

#: spoolsteward/admin/templates/_own_notices.html:18
#, python-format
msgid "Your print key “%(label)s” (starts with %(prefix)s) expires on %(date)s. Create a new one before then and set it up on your devices."
msgstr "Tu clave de impresión «%(label)s» (empieza por %(prefix)s) caduca el %(date)s. Crea una nueva antes de esa fecha y configúrala en tus dispositivos."

#: spoolsteward/admin/templates/_own_notices.html:20
#, python-format
msgid "An administrator moved you from the group “%(old)s” to the group “%(new)s”. Your limits are now those of the new group."
msgstr "Un administrador te ha movido del grupo “%(old)s” al grupo “%(new)s”. Tus límites son ahora los del nuevo grupo."

